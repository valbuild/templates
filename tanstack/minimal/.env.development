# Content analytics while you develop. `npm run dev` reads this file, and
# nothing else does: a build ignores it, and on Val's hosting analytics is
# switched on in the project's settings.
#
# With it on, your pages behave as a visitor's do on a site with analytics
# switched on, and the browser console names any content whose edit tag
# left React: a <title>, JSON-LD, a URL built with encodeURIComponent. Wrap
# the value in val.raw() where it leaves React. Nothing is counted locally.
VAL_ANALYTICS=true

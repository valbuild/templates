{
  "$comment": "What `npm create @valbuild` and admin.val.build/new can offer, and what each optional feature is made of. Read by both at run time, so a template is added, renamed or retired here and nowhere else. `node scripts/catalog.mjs --check` verifies every path, dependency and marker below against the templates. See README.md.",
  "version": 1,
  "templates": [
    {
      "id": "tanstack-full",
      "framework": "tanstack",
      "name": "Full",
      "description": "A site to build on: a theme editors can change, sections, light and dark, Storybook",
      "path": "tanstack/full",
      "icon": "catalog/icons/full.svg",
      "screenshots": [
        "catalog/screenshots/tanstack-full-light.png",
        "catalog/screenshots/tanstack-full-dark.png"
      ],
      "features": {
        "mcp": {
          "paths": [
            "src/routes/api/mcp.ts",
            "src/routes/[.]well-known.oauth-protected-resource.ts",
            "src/val/mcp.server.ts",
            "src/val/mcp.images.server.ts"
          ],
          "dependencies": [
            "@valbuild/mcp",
            "@modelcontextprotocol/server",
            "mcp-handler",
            "zod",
            "sharp"
          ],
          "docs": [
            "README.md",
            "AGENTS.md"
          ]
        },
        "imageUploads": {
          "file": "src/val/mcp.images.server.ts",
          "dependencies": [
            "sharp"
          ]
        }
      },
      "regenerate": {
        "script": "generate-routes",
        "files": [
          "src/routeTree.gen.ts"
        ]
      }
    },
